# App
NEXT_PUBLIC_APP_NAME=Frozeria Stok
NEXT_PUBLIC_APP_VERSION=0.4.0

# Database
DATABASE_URL=

# Storage driver: local | cloudinary | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_PUBLIC_PATH=/uploads

# Cloudinary storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible storage, including AWS S3, MinIO, Cloudflare R2, or similar providers
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
